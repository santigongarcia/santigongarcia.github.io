{
  "name": "Certification",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "issuer": {
      "type": "string",
      "title": "Entidad emisora"
    },
    "tag": {
      "type": "string",
      "title": "Etiqueta"
    },
    "logoUrl": {
      "type": "string",
      "title": "URL del logo"
    },
    "certificateImageUrl": {
      "type": "string",
      "title": "URL de la imagen del certificado"
    },
    "order": {
      "type": "number",
      "title": "Orden",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}